# ML specific
models/*.pkl
models/*.joblib

# Phase 10: generated MLflow tracking state. The experiment name, the
# configuration and the tooling are all tracked; only the local store is not,
# because it is a machine-local SQLite database that grows with every run.
experiments/
mlruns/
mlartifacts/
experiments/tracking/
experiments/tracking/*.db

# Generated report data. The per-phase Markdown reports are deliverable
# documentation, not build output, so reports/*.md is deliberately NOT ignored.
reports/*.csv
reports/*.json
reports/*.html

# Datasets: only the small synthetic samples are versioned, real datasets are not
datasets/*
!datasets/.gitkeep
!datasets/sample_*.csv

# Runtime logs (created automatically on import)
logs/

# OS specific
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
