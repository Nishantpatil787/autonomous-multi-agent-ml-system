# Environment variables
#
# Every value here is optional and commented out. The project runs with no
# environment file at all: the defaults in utils/config.py are the documented
# behaviour, and this file only exists to show what can be overridden.
#
# Nothing here is a credential. There is no API key in this project, Phase 8's
# optional LLM layer talks to a local Ollama over loopback, and Phase 10's
# tracking store is a local SQLite file.

# --------------------------------------------------------------------------- #
# Logging (all phases)
# --------------------------------------------------------------------------- #
# One of DEBUG, INFO, WARNING, ERROR. INFO is the default.
# LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# Optional local LLM layer (Phase 8)
# --------------------------------------------------------------------------- #
# The address of your own local Ollama. Loopback only: the project refuses a
# non-local host, so no project data can leave the machine. The layer is off
# unless app.py is run with --llm.
# OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------------------------------------- #
# Experiment tracking (Phase 10)
# --------------------------------------------------------------------------- #
# Turn tracking off for every run. The --no-mlflow flag does this for one run
# and takes precedence over this variable.
# MLFLOW_ENABLED=false

# Where the tracking store lives. Leave this unset for the default, a local
# SQLite file under experiments/tracking/ - no server, no account, no network.
#
# Set it only to point a throwaway experiment at your own local MLflow server:
#   MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_TRACKING_URI=sqlite:///C:/path/to/project/experiments/tracking/mlflow.db
#
# The URI must use the sqlite:/// scheme for a local file. A bare file:// URI is
# routed to MLflow's filesystem store, which MLflow 3.x refuses to write to.
# MLFLOW_TRACKING_URI=

# The experiment every run is recorded under.
# MLFLOW_EXPERIMENT_NAME=autonomous-multi-agent-ml

# How many runs the dashboard's "Experiment tracking" section lists. Bounded on
# purpose: the dashboard is a report, not an MLflow replacement.
# MLFLOW_HISTORY_LIMIT=10

# Also copy the fitted pipeline into the run's artifact directory. Off by
# default and expected to stay off: models/best_model.joblib is the project's
# single deployment artifact, and a second serialized copy would be a second
# thing to keep in sync.
# MLFLOW_LOG_MODEL_ARTIFACT=false